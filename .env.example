PORT=3001
# Autenticação (decisão D12): NÃO existe mais chave global.
# Cada instalação do Sincronizador tem sua própria API key cadastrada em
# setes_central.tb_sync_api_key (active='S') — resolve institutionId + schemaName.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha
DB_NAME=setes_central
